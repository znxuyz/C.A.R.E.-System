rules_version = '2';

/**
 * C.A.R.E. System — Firestore 安全規則（單人操作版）
 *
 * 授權模型
 *  - 只有兩種身分：DISCIPLINE_STAFF（生活教育組長）與 ADMIN。
 *    角色存於 Firebase Auth custom claims：request.auth.token.roles: string[]
 *  - 未登入者只能讀取一份文件：publicBoard/today
 *    （由 Cloud Functions 產生的**去識別化摘要**，不含姓名、學號或個別事件明細）
 *
 * 寫入原則
 *  - 所有業務寫入一律走 Cloud Functions callable（Admin SDK 繞過本規則），
 *    client 端完全無寫入權限。這確保伺服器時戳、再犯認列欄位
 *    （consumedByAlertId）與管制狀態不可被前端竄改。
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- 共用函式 ----------------------------- */

    function roles() {
      return request.auth != null && 'roles' in request.auth.token
        ? request.auth.token.roles
        : [];
    }

    function isStaff() {
      return 'DISCIPLINE_STAFF' in roles() || 'ADMIN' in roles();
    }

    function isAdmin() {
      return 'ADMIN' in roles();
    }

    /* --------------------- 公開唯讀看板（唯一匿名可讀） -------------------- */

    match /publicBoard/{docId} {
      // 內容為統計數字；僅在設定開啟 showRoster 時另含「班級＋座號」，永不含姓名
      allow read: if true;
      allow write: if false;   // 僅 Cloud Functions 產生
    }

    /* --------------------------- 設定類（唯讀） --------------------------- */

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if false;   // 經 updateSettings callable
    }

    match /infractionTypes/{code} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /locations/{code} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /schoolCalendar/{day} {
      allow read: if isStaff();
      allow write: if false;
    }

    /* ------------------------------ 人員主檔 ------------------------------ */

    match /classes/{classId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /students/{studentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /staff/{uid} {
      allow read: if isStaff();
      allow write: if false;
    }

    /**
     * 以 Google 信箱預先授權的名單。
     * 含尚未登入者的信箱與角色，屬個資且是提權的關鍵資料，
     * 因此對前端完全關閉，只有 Cloud Functions（Admin SDK）可讀寫。
     */
    match /accessGrants/{email} {
      allow read, write: if false;
    }

    /* ------------------------------ 業務資料 ------------------------------ */

    match /infractions/{infractionId} {
      allow read: if isStaff();
      allow write: if false;   // createInfraction / returnPaperCard / annotateCase
    }

    match /recessRestrictions/{restrictionId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /recidivismAlerts/{alertId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /observerAssignments/{assignmentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    /* ------------------------- 敏感集合（前端關閉） ------------------------ */

    /** Trigger Email 擴充套件的寄信佇列 */
    match /mail/{mailId} {
      allow read, write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* --------------------------- 預設全部拒絕 ---------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
