rules_version = '2';

/**
 * C.A.R.E. System — Firestore 安全規則
 *
 * 架構前提：本系統不使用 Cloud Functions（需付費方案），
 * 所有業務邏輯在前端執行，因此**安全規則是唯一的防線**，
 * 除了權限判定外也負責驗證每一筆寫入的形狀與關鍵欄位。
 *
 * 角色來源：`staff/{uid}.roles`（而非 custom claims）。
 *  - 優點：取消授權下一次請求即生效，不必等 token 過期。
 *  - 代價：每次規則判定多一次文件讀取（同一請求內會快取）。
 *
 * 授權鏈：
 *   seed 指令建立 accessGrants/{管理者信箱}
 *     → 管理者 Google 登入後，前端讀「自己那筆」授權並建立 staff/{uid}
 *       （規則驗證 roles 必須等於授權內容，無法自行提權）
 *     → 管理者於帳號管理頁寫入其他人的 accessGrants
 *
 * 時間戳：所有 createdAt / updatedAt 須等於 request.time（serverTimestamp），
 * 因此即使寫入端在前端，稽核時間仍無法造假。
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- 身分判定 ----------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return signedIn() && 'email' in request.auth.token
        ? request.auth.token.email.lower()
        : '';
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }

    function myRoles() {
      return signedIn() && exists(staffPath()) && get(staffPath()).data.active == true
        ? get(staffPath()).data.roles
        : [];
    }

    function isStaff() {
      return 'DISCIPLINE_STAFF' in myRoles() || 'ADMIN' in myRoles();
    }

    function isAdmin() {
      return 'ADMIN' in myRoles();
    }

    /* ----------------------------- 驗證輔助 ----------------------------- */

    function isSchoolDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    /** 時間戳必須由伺服器決定 */
    function serverTime(field) {
      return request.resource.data[field] == request.time;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function validRoles(roles) {
      return roles is list && roles.size() > 0
        && roles.hasOnly(['ADMIN', 'DISCIPLINE_STAFF']);
    }

    /* --------------------- 公開唯讀看板（唯一匿名可讀） -------------------- */

    match /publicBoard/{docId} {
      // 內容為統計數字；僅在設定開啟 showRoster 時另含「班級＋座號」，永不含姓名
      allow read: if true;
      allow write: if isStaff() && serverTime('updatedAt');
    }

    /* ------------------------------ 授權名單 ------------------------------ */

    match /accessGrants/{email} {
      // 只能讀自己的那一筆（登入後據此建立 staff 文件）；管理者可讀全部
      allow get: if isAdmin() || (signedIn() && myEmail() == email);
      allow list: if isAdmin();

      allow create, delete: if isAdmin()
        && request.resource.data.email == email
        && validRoles(request.resource.data.roles);

      allow update: if
        (isAdmin() && validRoles(request.resource.data.roles))
        // 本人領取授權時只能標記「已領取」
        || (signedIn() && myEmail() == email
            && onlyChanges(['claimedByUid', 'claimedAt'])
            && request.resource.data.claimedByUid == request.auth.uid);
    }

    /* ------------------------------ 使用者 ------------------------------- */

    /** 建立/更新自己的 staff 文件時，角色必須與授權名單完全一致 */
    function grantMatches() {
      return exists(/databases/$(database)/documents/accessGrants/$(myEmail()))
        && get(/databases/$(database)/documents/accessGrants/$(myEmail())).data.active == true
        && request.resource.data.roles
             == get(/databases/$(database)/documents/accessGrants/$(myEmail())).data.roles;
    }

    match /staff/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.active == true
        && grantMatches();

      allow update: if
        // 本人重新領取（角色異動後重新登入）
        (signedIn() && request.auth.uid == uid
          && request.resource.data.active == true
          && grantMatches())
        // 管理者調整角色或停用
        || (isAdmin() && request.resource.data.roles is list
            && request.resource.data.roles.hasOnly(['ADMIN', 'DISCIPLINE_STAFF']));

      allow delete: if false;
    }

    /* ------------------------------ 主檔資料 ------------------------------ */

    match /students/{studentId} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      // 生教組僅能更新再犯視窗快取（交易計數用），其餘欄位須管理者
      allow update: if isAdmin() || (isStaff() && onlyChanges(['recidivismWindow']));
    }

    /**
     * 名冊搜尋索引（少數幾份聚合文件，取代逐份讀 students 以節省讀取額度）。
     * 內容是 students 的子集（學號／姓名／班級／座號／在校），
     * 因此讀取權限與 students 相同：僅限生教組，不對外公開。
     */
    match /rosterIndex/{chunkId} {
      allow read: if isStaff();
      allow write: if isAdmin() && serverTime('updatedAt');
    }

    match /classes/{classId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /infractionTypes/{code} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /locations/{code} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /schoolCalendar/{day} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    /* ------------------------------ 系統設定 ------------------------------ */

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.recidivismWindowDays is int
        && request.resource.data.recidivismWindowDays >= 1
        && request.resource.data.recidivismWindowDays <= 365
        // 發卡起算次數為後加欄位：沒帶就沿用預設，有帶則檢查範圍
        && (!('cardFromOffense' in request.resource.data)
            || (request.resource.data.cardFromOffense is int
                && request.resource.data.cardFromOffense >= 1
                && request.resource.data.cardFromOffense <= 20))
        && request.resource.data.recidivismThreshold is int
        && request.resource.data.recidivismThreshold >= 1
        && request.resource.data.recidivismThreshold <= 20
        && request.resource.data.observerPeriods is int
        && request.resource.data.observerPeriods >= 1
        && request.resource.data.observerPeriods <= 12
        && serverTime('updatedAt');
    }

    /** 每日續帳的執行紀錄（取代排程函式） */
    match /systemState/{docId} {
      allow read: if isStaff();
      allow write: if isStaff() && serverTime('lastRunAt');
    }

    /* ------------------------------ 違規事件 ------------------------------ */

    match /infractions/{infractionId} {
      allow read: if isStaff();

      allow create: if isStaff()
        && request.resource.data.studentId is string
        && isSchoolDate(request.resource.data.occurredOn)
        // 發卡的案件以 OPEN 起始（待回收紙本）；
        // 期間內第一次只記錄勸導時沒有紙本要回收，直接以 DONE 結案。
        // 但「已發卡卻一開始就標記為結案」不允許，避免略過回收流程。
        && request.resource.data.status in ['OPEN', 'DONE']
        && (request.resource.data.status == 'OPEN'
            || request.resource.data.cardIssued == false)
        && request.resource.data.countsTowardRecidivism is bool
        && (request.resource.data.consumedByAlertId == null
            || request.resource.data.consumedByAlertId is string)
        // 登錄者必須是本人，事後無法偽造是誰登錄的
        && request.resource.data.recordedBy.uid == request.auth.uid
        && serverTime('createdAt') && serverTime('updatedAt');

      allow update: if isStaff()
        && unchanged('studentId') && unchanged('occurredOn')
        && unchanged('typeCode') && unchanged('createdAt') && unchanged('recordedBy')
        && request.resource.data.status in ['OPEN', 'DONE', 'EXEMPTED', 'VOIDED']
        && serverTime('updatedAt');

      allow delete: if false;   // 誤報請用「撤銷」，保留軌跡
    }

    /* ---------------------------- 下課管制每日帳 --------------------------- */

    match /recessRestrictions/{restrictionId} {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.data.studentId is string
        && isSchoolDate(request.resource.data.date)
        // 正向管教保障：飲水與如廁不受限，規則層級強制
        && request.resource.data.allowWaterAndRestroom == true
        && request.resource.data.status in ['ACTIVE', 'LIFTED', 'CANCELLED']
        && serverTime('updatedAt');
      allow delete: if false;
    }

    /* ------------------------------ 再犯警示 ------------------------------ */

    match /recidivismAlerts/{alertId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.studentId is string
        && request.resource.data.count is int
        && request.resource.data.threshold is int
        && serverTime('createdAt') && serverTime('updatedAt');
      allow update: if isStaff()
        && unchanged('studentId') && unchanged('count') && unchanged('threshold')
        && unchanged('windowStart') && unchanged('windowEnd')
        && request.resource.data.status in ['OPEN', 'ACKNOWLEDGED', 'ASSIGNED', 'CLOSED', 'DISMISSED']
        && serverTime('updatedAt');
      allow delete: if false;
    }

    /* --------------------------- 安全觀察員派單 --------------------------- */

    match /observerAssignments/{assignmentId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.studentId is string
        && isSchoolDate(request.resource.data.dutyOn)
        && request.resource.data.totalPeriods is int
        && serverTime('createdAt') && serverTime('updatedAt');
      allow update: if isStaff()
        && unchanged('studentId') && unchanged('alertId') && unchanged('createdAt')
        && request.resource.data.status in
             ['SCHEDULED', 'IN_PROGRESS', 'DUTY_COMPLETED', 'CLOSED', 'CANCELLED']
        && serverTime('updatedAt');
      allow delete: if false;
    }

    /* ------------------------------- 稽核 -------------------------------- */

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // 僅可新增，且必須是本人、時間由伺服器決定；不可修改或刪除
      allow create: if isStaff()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string
        && serverTime('createdAt');
      allow update, delete: if false;
    }

    /* --------------------------- 預設全部拒絕 ---------------------------- */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
