{
  "indexes": [
    {
      "//": "核心：再犯 15 天視窗查詢（studentId + 旗標 + status IN + occurredOn 範圍）",
      "collectionGroup": "infractions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "countsTowardRecidivism", "order": "ASCENDING" },
        { "fieldPath": "consumedByAlertId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "occurredOn", "order": "ASCENDING" }
      ]
    },
    {
      "//": "待回收紙本清單 / 排程續帳（狀態 + 發生日）",
      "collectionGroup": "infractions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "occurredOn", "order": "DESCENDING" }
      ]
    },
    {
      "//": "學生個人違規歷程",
      "collectionGroup": "infractions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "occurredOn", "order": "DESCENDING" }
      ]
    },
    {
      "//": "班級統計",
      "collectionGroup": "infractions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "classId", "order": "ASCENDING" },
        { "fieldPath": "occurredOn", "order": "DESCENDING" }
      ]
    },
    {
      "//": "今日管制名單（依班級排序）",
      "collectionGroup": "recessRestrictions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "date", "order": "ASCENDING" },
        { "fieldPath": "className", "order": "ASCENDING" }
      ]
    },
    {
      "//": "解鎖處理：某生仍在管制中的日期",
      "collectionGroup": "recessRestrictions",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "studentId", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "ASCENDING" }
      ]
    },
    {
      "//": "安全觀察員追蹤清單（未結案 + 值勤日）",
      "collectionGroup": "observerAssignments",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "dutyOn", "order": "ASCENDING" }
      ]
    },
    {
      "//": "再犯警示清單（待處理優先）",
      "collectionGroup": "recidivismAlerts",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "triggeredAt", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
