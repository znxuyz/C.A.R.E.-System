rules_version = '2';

/**
 * Cloud Storage 規則
 * 用途：違規現場照片（選用）、電子簽章筆跡圖、檢討書附件。
 * 一律由 Cloud Functions 產生簽名網址或代寫，前端僅可讀取自己相關的檔案。
 */
service firebase.storage {
  match /b/{bucket}/o {
    function roles() {
      return request.auth != null && 'roles' in request.auth.token
        ? request.auth.token.roles
        : [];
    }
    function isOffice() {
      return 'DISCIPLINE_STAFF' in roles() || 'ADMIN' in roles();
    }

    // 簽章筆跡：{stage}/{documentId}/{uid}.png
    match /signatures/{stage}/{documentId}/{fileName} {
      allow read: if isOffice() || 'HOMEROOM_TEACHER' in roles();
      allow write: if request.auth != null
        && request.resource.size < 512 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // 違規現場照片：僅生教組可讀寫，2MB 上限
    match /evidence/{infractionId}/{fileName} {
      allow read, write: if isOffice()
        && request.resource.size < 2 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
